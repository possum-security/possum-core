{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "possum",
          "version": "v0.1.0-dev",
          "informationUri": "https://possum.io",
          "rules": [
            {
              "id": "s3_bucket_level_public_access_block",
              "name": "s3 bucket level public access block",
              "shortDescription": {
                "text": "S3 bucket public access block disabled"
              },
              "fullDescription": {
                "text": "S3 Block Public Access is disabled on bucket."
              },
              "helpUri": "https://possum.io/rules/s3_bucket_level_public_access_block",
              "properties": {
                "security-severity": "9.0",
                "tags": [
                  "security",
                  "security"
                ],
                "severity": "CRITICAL",
                "category": "SECURITY",
                "remediation": "aws s3api put-public-access-block --bucket production-customer-data"
              }
            },
            {
              "id": "ec2_securitygroup_allow_ingress_from_internet_to_any_port",
              "name": "ec2 securitygroup allow ingress from internet to any port",
              "shortDescription": {
                "text": "Security group allows ingress from internet to any port"
              },
              "fullDescription": {
                "text": "Security group has unrestricted ingress rule from 0.0.0.0/0."
              },
              "helpUri": "https://possum.io/rules/ec2_securitygroup_allow_ingress_from_internet_to_any_port",
              "properties": {
                "security-severity": "7.0",
                "tags": [
                  "security",
                  "security"
                ],
                "severity": "HIGH",
                "category": "SECURITY",
                "remediation": "Restrict security group ingress to specific IP CIDRs or security groups."
              }
            },
            {
              "id": "ebs_volume_unused_attached",
              "name": "ebs volume unused attached",
              "shortDescription": {
                "text": "Unattached EBS Volume Generating Waste"
              },
              "fullDescription": {
                "text": "EBS volume is not attached to any EC2 instance."
              },
              "helpUri": "https://possum.io/rules/ebs_volume_unused_attached",
              "properties": {
                "security-severity": "4.0",
                "tags": [
                  "security",
                  "finops"
                ],
                "severity": "MEDIUM",
                "category": "FINOPS",
                "remediation": "Delete unattached EBS volume or snapshot and archive.",
                "cost_waste_monthly": 38.5
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "s3_bucket_level_public_access_block",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "S3 Block Public Access is disabled on bucket.\nRemediation: aws s3api put-public-access-block --bucket production-customer-data"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "terraform/s3.tf"
                },
                "region": {
                  "startLine": 42
