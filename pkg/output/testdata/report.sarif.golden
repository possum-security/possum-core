              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "48aa401b4f44d14de48ed4b9ca97cadc5848e78347bf47e30304476e5f528252"
          }
        },
        {
          "ruleId": "ec2_securitygroup_allow_ingress_from_internet_to_any_port",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Security group has unrestricted ingress rule from 0.0.0.0/0.\nRemediation: Restrict security group ingress to specific IP CIDRs or security groups."
          },
          "locations": [
